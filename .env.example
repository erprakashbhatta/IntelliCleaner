# PhotoMind — AI Photo Deduplication System
# Environment configuration
# Copy this to .env and fill in your values

# ── LLM Provider (choose one) ─────────────────────────────────────
# Option 1: OpenAI (best quality, requires API key)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...your-key-here...

# Option 2: Anthropic Claude (also excellent, requires API key)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-4-6
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Option 3: Local Ollama (free, runs on your machine)
# Requires: brew install ollama && ollama pull llava:13b
# LLM_PROVIDER=ollama
# LLM_MODEL=llava:13b
# OLLAMA_BASE_URL=http://localhost:11434

# ── Optional ───────────────────────────────────────────────────────
# DEBUG=false
